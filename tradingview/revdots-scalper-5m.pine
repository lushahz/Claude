//@version=6
// This source code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// RevDots Scalper 5m - volatility-spike dip buyer for BTC / ETH perpetuals on the 5-minute chart
//
// Signal (long only), all on the close of a 5-minute bar:
//   1. Volatility spike: 5m ATR(14) is at least X times the 30-day average of the 1-hour ATR(14)
//      (the 1-hour baseline needs no long 5m history, so signals show on every TradingView plan)
//   2. Dip: price is at least Y ATR below the daily VWAP
//   3. Oversold: RSI(14) below Z
//   4. Uptrend: the last daily close is above the daily EMA 50
// Modes (X / Y / Z):  Active 0.45 / 2 / 30 (default)   Balanced 0.7 / 2 / 40   Strict 0.7 / 3 / 30
//
// Active mode, net of 0.08% cost, per coin (2020-26): about 1.5 signals a week per coin in 2025-26, 80-86% won, and every one
// of 9 coins tested (BTC ETH SOL XRP BNB DOGE ADA AVAX LINK) was profitable in 2024-26. Thin on BTC / ETH (+0.03-0.07% per
// trade), better on altcoins (+0.1-0.2%). For several signals a day, use the companion "RevDots Scalp Scanner", which
// watches all 9 coins from one chart and limits open trades to 3 at a time.
//
// Trade: enter at the next bar's open, take profit +1 ATR, emergency stop -10 ATR, exit at the close after 24 bars (2 hours).
//
// Strict mode research (Binance USDT-M perpetuals, Jan 2020 - Oct 2026, stops and targets checked on 1-minute data, 0.08% round-trip cost):
//   BTCUSDT: 192 trades, 79.7% won, +0.19% per trade, profit factor 1.59, total +36.9% (1x, no compounding), max DD 16.5%
//            2020-22 +0.18%/trade, 2023 +0.24%, 2024-26 +0.18% (81% won)
//   ETHUSDT: 238 trades, 84.5% won, +0.29% per trade, profit factor 1.73, total +68.8%, max DD 25.5%
// Short signals were tested the same way and had no edge after costs on 5m, on either coin, so there are none.
// Plain WaveTrend green / red dots on 5m were a coin flip before costs (about 50% won) and lost after costs.
//
// Know the risk profile: wins are small (avg +0.65%), losses are rare but large (avg -1.6%, worst -10% on BTC, -25% on ETH
// in a flash crash). 2022 lost money (BTC 5 trades, 1 winner). 2025 was flat. Strict mode gives about 2-3 signals a month,
// in bursts, and none for months when the market is calm (BTC: only 3 in 2026 so far).
// Not financial advice. Signals on the live bar can change until the bar closes.

indicator("RevDots Scalper 5m", shorttitle = "RevScalp", overlay = true, max_lines_count = 500, max_labels_count = 500)

// ---------------------------------------------------------------------------
// Inputs
// ---------------------------------------------------------------------------
grpS = "Signal"
mode      = input.string("Active", "Mode", options = ["Active", "Balanced", "Strict", "Custom"], group = grpS, tooltip = "Active: about 1-2 signals a week per coin, smallest edge per trade. Balanced: about 0.5-1 a week, about +0.2% per trade. Strict: about 0.2-0.5 a week, largest edge. Custom uses the three settings below.")
vwapDistIn  = input.float(2.0, "Custom: price at least this many ATR below the daily VWAP", minval = 0.5, step = 0.25, group = grpS)
rsiMaxIn    = input.float(30.0, "Custom: RSI below", minval = 1, maxval = 99, group = grpS)
spikeMultIn = input.float(0.45, "Custom: 5m ATR at least this many times the average 1h ATR", minval = 0.1, step = 0.05, group = grpS, tooltip = "Volatility spike filter. A normal 5m ATR is about 0.25-0.3x the 1h ATR, so 0.45 means the 5m bars are moving about 1.6x more than usual and 0.7 about 2.5x. Higher = fewer, better signals.")
rsiLen    = input.int(14, "RSI length", minval = 2, group = grpS)
atrLen    = input.int(14, "ATR length", minval = 1, group = grpS)
spikeMult = mode == "Active" ? 0.45 : mode == "Balanced" ? 0.7 : mode == "Strict" ? 0.7 : spikeMultIn
vwapDist  = mode == "Active" ? 2.0 : mode == "Balanced" ? 2.0 : mode == "Strict" ? 3.0 : vwapDistIn
rsiMax    = mode == "Active" ? 30.0 : mode == "Balanced" ? 40.0 : mode == "Strict" ? 30.0 : rsiMaxIn
avgDays   = input.int(30, "1h ATR average window (days)", minval = 5, maxval = 90, group = grpS)
useTrend  = input.bool(true, "Only when the last daily close is above the daily EMA", group = grpS, tooltip = "Without it the edge roughly halved on BTC and turned negative on ETH.")
trendLen  = input.int(50, "Daily EMA length", minval = 5, group = grpS)

grpT = "Trade"
tpAtr     = input.float(1.0, "Take profit (x ATR)", minval = 0.25, step = 0.25, group = grpT, tooltip = "Smaller targets win more often but make less per trade: 0.75 ATR about 87% won, 1.0 about 80-83%, 1.5 about 73% (BTC).")
slAtr     = input.float(10.0, "Emergency stop (x ATR)", minval = 2, step = 1, group = grpT, tooltip = "Wide on purpose: only 3 of 192 BTC trades reached it. Tighter stops (6-8 ATR) cut the profit by half or more.")
holdBars  = input.int(24, "Time exit after (bars)", minval = 1, group = grpT, tooltip = "24 bars = 2 hours on the 5-minute chart. Trades that reach neither level are closed at this bar's close.")
costPct   = input.float(0.08, "Round-trip cost % for the scorecard", minval = 0, step = 0.01, group = grpT)

grpV = "Display"
showLv    = input.bool(true, "Show entry / TP / SL lines", group = grpV)
showArmed = input.bool(true, "Shade bars where the market is armed (spike + uptrend)", group = grpV)
showVwap  = input.bool(true, "Show daily VWAP and the dip line", group = grpV)
showPanel = input.bool(true, "Show panel", group = grpV)
panelPos  = input.string("Top right", "Panel position", options = ["Top right", "Top left", "Bottom right", "Bottom left"], group = grpV)
colBuy    = input.color(#00E676, "Buy", group = grpV)
colStop   = input.color(#FF5252, "Stop", group = grpV)

// ---------------------------------------------------------------------------
// Calculations
// ---------------------------------------------------------------------------
atr   = ta.atr(atrLen)
rsi   = ta.rsi(close, rsiLen)
vwap  = ta.vwap(hlc3, timeframe.change("D"))
vwapD = atr > 0 ? (close - vwap) / atr : na

// Baseline: average 1-hour ATR over the last avgDays days, from the last closed 1h bar.
// Taken from the 1h timeframe so it does not depend on how many 5m bars the chart has loaded.
hAtrAvg  = request.security(syminfo.tickerid, "60", ta.sma(ta.atr(atrLen), avgDays * 24)[1], lookahead = barmerge.lookahead_on)
atrRatio = hAtrAvg > 0 ? atr / hAtrAvg : na

// Last closed daily bar: close above its EMA
dUp = request.security(syminfo.tickerid, "D", close[1] > ta.ema(close, trendLen)[1], lookahead = barmerge.lookahead_on)

condSpike = not na(atrRatio) and atrRatio >= spikeMult
condDip   = not na(vwapD) and vwapD <= -vwapDist
condRsi   = rsi < rsiMax
condTrend = not useTrend or dUp
setup     = condSpike and condDip and condRsi and condTrend
armed     = condSpike and condTrend

// ---------------------------------------------------------------------------
// Trade engine: one trade at a time, entry at the next bar's open
// ---------------------------------------------------------------------------
var int   pos    = 0
var int   pend   = 0
var float pSl    = na
var float pTp    = na
var float ep     = na
var float sl     = na
var float tp     = na
var int   eBar   = na
var line  lnEp   = na
var line  lnSl   = na
var line  lnTp   = na
var int   nTr    = 0
var int   nWin   = 0
var float sumPct = 0.0
var float grossW = 0.0
var float grossL = 0.0
var float peak   = 0.0
var float maxDD  = 0.0
var string lastTxt = "-"

exitNow = false
xp      = 0.0
why     = ""

if pend == 1 and pos == 0
    pos  := 1
    ep   := open
    sl   := pSl
    tp   := ep + pTp
    eBar := bar_index
    if showLv
        lnEp := line.new(bar_index, ep, bar_index, ep, color = color.gray, width = 1)
        lnSl := line.new(bar_index, sl, bar_index, sl, color = colStop, width = 1, style = line.style_dashed)
        lnTp := line.new(bar_index, tp, bar_index, tp, color = colBuy, width = 2)
pend := 0

if pos == 1
    if low <= sl
        exitNow := true
        xp      := math.min(open, sl)
        why     := "SL"
    else if high >= tp
        exitNow := true
        xp      := math.max(open, tp)
        why     := "TP"
    else if bar_index - eBar >= holdBars
        exitNow := true
        xp      := close
        why     := "Time"
    if showLv and not na(lnEp)
        line.set_x2(lnEp, bar_index)
        line.set_x2(lnSl, bar_index)
        line.set_x2(lnTp, bar_index)

wasOpen = pos == 1
if exitNow
    pnl = (xp / ep - 1) * 100 - costPct
    nTr    += 1
    nWin   += pnl > 0 ? 1 : 0
    sumPct += pnl
    grossW += pnl > 0 ? pnl : 0.0
    grossL += pnl < 0 ? -pnl : 0.0
    peak   := math.max(peak, sumPct)
    maxDD  := math.max(maxDD, peak - sumPct)
    lastTxt := why + " " + (pnl >= 0 ? "+" : "") + str.tostring(pnl, "#.##") + "%"
    label.new(bar_index, why == "TP" ? high : low, lastTxt, style = why == "TP" ? label.style_label_down : label.style_label_up, color = pnl > 0 ? color.new(colBuy, 20) : color.new(colStop, 20), textcolor = color.black, size = size.tiny)
    pos := 0

newSig = setup and pos == 0 and pend == 0 and not exitNow and not wasOpen
if newSig
    pend := 1
    pSl  := close - slAtr * atr
    pTp  := tpAtr * atr
    tpEst = close + pTp
    label.new(bar_index, low, "BUY", style = label.style_label_up, color = colBuy, textcolor = color.black, size = size.small)
    alert(syminfo.ticker + " " + timeframe.period + ": SCALP BUY - enter next bar open, about " + str.tostring(close, format.mintick) + " | TP " + str.tostring(tpEst, format.mintick) + " | SL " + str.tostring(pSl, format.mintick) + " | time exit after " + str.tostring(holdBars) + " bars", alert.freq_once_per_bar_close)

// ---------------------------------------------------------------------------
// Plots
// ---------------------------------------------------------------------------
plot(showVwap ? vwap : na, "Daily VWAP", color = color.new(color.orange, 20), linewidth = 1)
plot(showVwap ? vwap - vwapDist * atr : na, "VWAP - x ATR", color = color.new(colBuy, 50), linewidth = 1, style = plot.style_linebr)
bgcolor(showArmed and armed ? color.new(colBuy, 90) : na, title = "Armed")
plotshape(newSig, "Scalp buy", shape.triangleup, location.belowbar, colBuy, size = size.tiny)

// ---------------------------------------------------------------------------
// Panel
// ---------------------------------------------------------------------------
var table tb = table.new(panelPos == "Top left" ? position.top_left : panelPos == "Bottom right" ? position.bottom_right : panelPos == "Bottom left" ? position.bottom_left : position.top_right, 2, 11, bgcolor = color.new(#131722, 10), border_width = 1, border_color = color.new(color.gray, 70))
f_row(r, k, v, c) =>
    table.cell(tb, 0, r, k, text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 1, r, v, text_color = c, text_size = size.small, text_halign = text.align_right)
if showPanel and barstate.islast
    ok  = color.new(colBuy, 0)
    bad = color.new(color.gray, 0)
    tfWarn = timeframe.period != "5" ? "Built for the 5m chart" : "5m"
    f_row(0, "RevDots Scalper", tfWarn, timeframe.period != "5" ? color.yellow : color.white)
    f_row(1, "Trade", pos == 1 ? "LONG open (TP " + str.tostring(tp, format.mintick) + ")" : pend == 1 ? "Entry next bar" : "Flat (last: " + lastTxt + ")", pos == 1 ? colBuy : color.white)
    f_row(2, "1. Volatility spike", na(atrRatio) ? "warming up" : str.tostring(atrRatio, "#.##") + "x of 1h ATR (need " + str.tostring(spikeMult) + ")", condSpike ? ok : bad)
    f_row(3, "2. Below VWAP", na(vwapD) ? "-" : str.tostring(vwapD, "#.#") + " ATR (need -" + str.tostring(vwapDist) + ")", condDip ? ok : bad)
    f_row(4, "3. RSI", str.tostring(rsi, "#") + " (need < " + str.tostring(rsiMax) + ")", condRsi ? ok : bad)
    f_row(5, "4. Daily uptrend", not useTrend ? "off" : dUp ? "yes" : "no", condTrend ? ok : bad)
    f_row(6, "Trades / win %", str.tostring(nTr) + " / " + (nTr > 0 ? str.tostring(100.0 * nWin / nTr, "#.#") : "-"), color.white)
    f_row(7, "Avg per trade", nTr > 0 ? str.tostring(sumPct / nTr, "#.###") + "%" : "-", nTr > 0 and sumPct > 0 ? colBuy : color.white)
    pf = grossL > 0 ? grossW / grossL : na
    f_row(8, "Profit factor", na(pf) ? "-" : str.tostring(pf, "#.##"), na(pf) ? color.white : pf >= 1 ? colBuy : colStop)
    f_row(9, "Total / max DD", str.tostring(sumPct, "#.#") + "% / " + str.tostring(maxDD, "#.#") + "%", color.white)
    f_row(10, "Mode", mode + " (" + str.tostring(spikeMult) + " / " + str.tostring(vwapDist) + " / " + str.tostring(rsiMax) + "), long only", color.silver)

alertcondition(newSig, "Scalp buy", "{{ticker}} {{interval}}: SCALP BUY - volatility spike dip in a daily uptrend. Enter next bar open, TP +1 ATR, SL -10 ATR, exit after 2 hours.")
alertcondition(armed and not armed[1], "Market armed", "{{ticker}} {{interval}}: volatility spike in a daily uptrend - watch for a scalp buy")
