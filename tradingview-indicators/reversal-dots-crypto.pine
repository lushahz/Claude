//@version=6
// This source code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// Reversal Dots Crypto
//
// Crypto-specialist, daily-only version of Reversal Dots. Built from a study of
// 29 coins (2014-2026) plus TOTAL, BTC dominance and USDT dominance:
//
//   BUY (green): the daily reversal trigger (waves <= -53, RSI <= 40, price
//     >= 2 ATRs below the 50 EMA, bullish confirming close within 3 bars), plus:
//     - Altcoins: Bitcoin's RSI <= 40 in the last 10 days, and BTC dominance
//       below its 20 EMA (money rotating into alts)
//     - Cycle guard: no new buys while Bitcoin is 25-60% below its 1-year high
//       (the "first leg down after a cycle top" zone)
//   PULLBACK BUY (light green): a dip inside an uptrend - coin above its
//     200 EMA with the 50 EMA above the 200 EMA, green dot after the slow wave
//     dipped to -20 or lower and RSI to 50 or lower, bullish confirming close
//     within 3 bars; altcoins also need Bitcoin above its 200 EMA
//   TAKE-PROFIT (red): overbought in the last 15 days (waves >= 53 and
//     RSI >= 70), then the first close below the 20 EMA
//   CYCLE EXIT (orange): Bitcoin's 50 EMA crosses below its 200 EMA
//   Failed reversal (yellow x): close below the pre-buy low minus 1 ATR
//
// TOTAL and USDT dominance are shown in the market panel for context. In the
// tests they didn't improve the triggers, so they don't change any signal.
//
// Not financial advice. Past results do not predict future results.

indicator("Reversal Dots Crypto", shorttitle = "RevDots Crypto", overlay = false, precision = 1, max_labels_count = 500)

// ---------------------------------------------------------------------------
// Inputs
// ---------------------------------------------------------------------------
grpBuy = "Buy trigger"
osWave     = input.float(-53.0, "Waves oversold: slow wave at or below (last 3 bars)", group = grpBuy, display = display.none)
osRsi      = input.float(40.0, "RSI oversold: RSI at or below (last 5 bars)", group = grpBuy, display = display.none)
stretchAtr = input.float(2.0, "Stretch: ATRs below the 50 EMA (last 10 bars)", minval = 0, step = 0.5, group = grpBuy, display = display.none)
confirmWin = input.int(3, "Confirmation window (bars)", minval = 0, group = grpBuy, display = display.none)
coolBars   = input.int(10, "Minimum bars between triggers", minval = 0, group = grpBuy, display = display.none)

grpCry = "Crypto filters"
btcSym     = input.symbol("BITSTAMP:BTCUSD", "Bitcoin reference", group = grpCry, display = display.none)
btcdSym    = input.symbol("CRYPTOCAP:BTC.D", "BTC dominance", group = grpCry, display = display.none)
useBtcRsi  = input.bool(true, "Altcoins: Bitcoin RSI oversold too", group = grpCry, display = display.none, inline = "br")
btcRsiMax  = input.float(40.0, "<=", group = grpCry, display = display.none, inline = "br")
useBtcD    = input.bool(true, "Altcoins: BTC dominance below its 20 EMA", group = grpCry, display = display.none)
useGuard   = input.bool(true, "Cycle guard: pause buys while BTC is in the zone below its 1-year high", group = grpCry, display = display.none,
     tooltip = "Skips buys while Bitcoin is between 25% and 60% below its 365-day high. In the tests this avoided most of the -70% to -85% trades bought in the first leg down after a cycle top, and it also skips some good bounces.")
guardLo    = input.float(25.0, "Guard zone from (% below 1-year high)", minval = 0, group = grpCry, display = display.none, inline = "gz")
guardHi    = input.float(60.0, "to", minval = 0, group = grpCry, display = display.none, inline = "gz")
useCycleEx = input.bool(true, "Cycle exit: end the trade on a Bitcoin 50/200 EMA death cross", group = grpCry, display = display.none)

grpPb = "Pullback buys (dips inside an uptrend)"
usePb   = input.bool(true, "Show pullback buys", group = grpPb, display = display.none,
     tooltip = "Adds about 2-4 buys per coin per year. In the tests they were profitable (profit factor 3.3 in 2014-21, 1.9 in 2022-26) but weaker than reversal buys, and they include losing clusters near cycle tops.")
pbWave  = input.float(-20.0, "Pullback: slow wave at or below (last 3 bars)", group = grpPb, display = display.none)
pbRsi   = input.float(50.0, "Pullback: RSI at or below (last 5 bars)", group = grpPb, display = display.none)

grpTp = "Take-profit trigger"
tpWave = input.float(53.0, "Overbought: slow wave at or above", group = grpTp, display = display.none)
tpRsi  = input.float(70.0, "Overbought: RSI at or above", group = grpTp, display = display.none)
tpLook = input.int(15, "Overbought within (bars)", minval = 1, group = grpTp, display = display.none)
tpEma  = input.int(20, "Exit when close falls below EMA", minval = 1, group = grpTp, display = display.none)

grpRisk = "Trade tracking"
failAtr  = input.float(1.0, "Failed reversal: ATRs below the pre-buy low", minval = 0, step = 0.5, group = grpRisk, display = display.none)
showAdds = input.bool(true, "Show every buy, also while already in a trade", group = grpRisk, display = display.none)

grpView = "Display"
dailyOnly   = input.bool(true, "Signals on the 1D chart only", group = grpView, display = display.none)
showWaves   = input.bool(true, "Show waves", group = grpView, display = display.none)
showEmas    = input.bool(true, "Show EMAs 20 / 50 / 200 on price", group = grpView, display = display.none)
showTable   = input.bool(true, "Show market panel", group = grpView, display = display.none)
totalSym    = input.symbol("CRYPTOCAP:TOTAL", "TOTAL market cap", group = grpView, display = display.none)
usdtdSym    = input.symbol("CRYPTOCAP:USDT.D", "USDT dominance", group = grpView, display = display.none)

grpCol = "Colors"
colWt1  = input.color(#4A7FC1, "Wave 1 (fast)", group = grpCol, display = display.none)
colWt2  = input.color(#262668, "Wave 2 (slow)", group = grpCol, display = display.none)
colBuy  = input.color(#00E676, "Reversal buy", group = grpCol, display = display.none)
colPb   = input.color(#7FD8BE, "Pullback buy", group = grpCol, display = display.none)
colTp   = input.color(#FF5252, "Take-profit", group = grpCol, display = display.none)
colCyc  = input.color(#FF9800, "Cycle exit", group = grpCol, display = display.none)
colFail = input.color(#FFD600, "Failed reversal", group = grpCol, display = display.none)
colE20  = input.color(#FF9800, "EMA 20", group = grpCol, display = display.none)
colE50  = input.color(#D1D4DC, "EMA 50", group = grpCol, display = display.none)
colE200 = input.color(#3949AB, "EMA 200", group = grpCol, display = display.none)

// ---------------------------------------------------------------------------
// Data
// ---------------------------------------------------------------------------
f_waves(src, chLen, avgLen, maLen) =>
    esa = ta.ema(src, chLen)
    de  = ta.ema(math.abs(src - esa), chLen)
    ci  = de == 0 ? 0.0 : (src - esa) / (0.015 * de)
    w1  = ta.ema(ci, avgLen)
    w2  = ta.sma(w1, maLen)
    [w1, w2]

f_trend() =>
    [close, ta.rsi(close, 14), ta.ema(close, 20), ta.ema(close, 50), ta.ema(close, 200)]

[wt1, wt2] = f_waves(hlc3, 9, 12, 3)
rsi    = ta.rsi(close, 14)
atr    = ta.atr(14)
ema20  = ta.ema(close, tpEma)
ema50  = ta.ema(close, 50)
ema200 = ta.ema(close, 200)
d50    = atr > 0 ? (close - ema50) / atr : 0.0

[bClose, bRsi, bE50, bE200, bHi] = request.security(btcSym, "D", [close, ta.rsi(close, 14), ta.ema(close, 50), ta.ema(close, 200), ta.highest(high, 365)])
[dClose, dRsi, dE20, dE50, dE200] = request.security(btcdSym, "D", f_trend())
[tClose, tRsi, tE20, tE50, tE200] = request.security(totalSym, "D", f_trend())
[uClose, uRsi, uE20, uE50, uE200] = request.security(usdtdSym, "D", f_trend())

isDaily = timeframe.isdaily and timeframe.multiplier == 1
active  = isDaily or not dailyOnly
isBtc   = syminfo.basecurrency == "BTC" or syminfo.basecurrency == "XBT"

// ---------------------------------------------------------------------------
// Buy trigger
// ---------------------------------------------------------------------------
crossUp   = ta.crossover(wt1, wt2)
lowWave   = ta.lowest(wt2, 3)
lowRsi    = ta.lowest(rsi, 5)
lowD50    = ta.lowest(d50, 10)
low5      = ta.lowest(low, 5)
btcRsiLow = ta.lowest(bRsi, 10)
hiWave    = ta.highest(wt2, tpLook)
hiRsi     = ta.highest(rsi, tpLook)

btcRsiOk = isBtc or not useBtcRsi or na(btcRsiLow) or btcRsiLow <= btcRsiMax
setup = crossUp and lowWave <= osWave and lowRsi <= osRsi and lowD50 <= -stretchAtr and btcRsiOk
var int lastSetup = na
if setup
    lastSetup := bar_index
clv        = high > low ? (close - low) / (high - low) : 0.0
bullishBar = close > open and close > close[1] and clv >= 0.5
confirmed  = not na(lastSetup) and bar_index - lastSetup <= confirmWin and bullishBar
if confirmed
    lastSetup := na

var int   lastBuyBar = na
var float lastBuyLow = na
rawBuy = false
if confirmed and (na(lastBuyBar) or bar_index - lastBuyBar > coolBars or low5 < lastBuyLow)
    rawBuy     := true
    lastBuyBar := bar_index
    lastBuyLow := low5

btcDD      = na(bHi) or bHi == 0 ? 0.0 : bClose / bHi - 1
guardOn    = useGuard and btcDD <= -guardLo / 100 and btcDD > -guardHi / 100
btcdOk     = isBtc or not useBtcD or na(dE20) or dClose < dE20
buyTrig    = rawBuy and active and btcdOk and not guardOn

// Pullback buy: dip inside an uptrend (own confirmation and cooldown)
upTrend = close > ema200 and ema50 > ema200
btcUp   = isBtc or na(bE200) or bClose > bE200
pbSetup = usePb and crossUp and upTrend and lowWave <= pbWave and lowRsi <= pbRsi and btcUp
var int lastPbSetup = na
if pbSetup
    lastPbSetup := bar_index
pbConfirmed = not na(lastPbSetup) and bar_index - lastPbSetup <= confirmWin and bullishBar
if pbConfirmed
    lastPbSetup := na
var int   lastPbBar = na
var float lastPbLow = na
pbTrig = false
if pbConfirmed and (na(lastPbBar) or bar_index - lastPbBar > coolBars or low5 < lastPbLow)
    pbTrig    := true
    lastPbBar := bar_index
    lastPbLow := low5
pbBuy = pbTrig and active and not buyTrig

// ---------------------------------------------------------------------------
// Exits
// ---------------------------------------------------------------------------
below   = close < ema20
crossDn = below and not below[1]
tpRaw   = crossDn and hiWave >= tpWave and hiRsi >= tpRsi
var int lastTpBar = na
tpTrig = false
if tpRaw and active and (na(lastTpBar) or bar_index - lastTpBar > coolBars)
    tpTrig    := true
    lastTpBar := bar_index

deathCross = ta.crossunder(bE50, bE200)
cycleExit  = useCycleEx and deathCross and active

// ---------------------------------------------------------------------------
// Trade tracking
// ---------------------------------------------------------------------------
var bool  inTrade = false
var float entryPx = na
var int   entryT  = na
var float failLvl = na
buyShown  = false
addShown  = false
pbShown   = false
pbAdd     = false
tpShown   = false
cycShown  = false
failShown = false

if inTrade
    if tpTrig
        tpShown := true
        inTrade := false
    else if cycleExit
        cycShown := true
        inTrade  := false
    else if not na(failLvl) and close < failLvl
        failShown := true
        failLvl   := na
if buyTrig
    if not inTrade
        inTrade  := true
        buyShown := true
        entryPx  := close
        entryT   := time
        failLvl  := low5 - failAtr * atr
    else
        addShown := true
if pbBuy
    if not inTrade
        inTrade := true
        pbShown := true
        entryPx := close
        entryT  := time
        failLvl := low5 - failAtr * atr
    else
        pbAdd := true

// ---------------------------------------------------------------------------
// Oscillator pane
// ---------------------------------------------------------------------------
hline(0, "Zero", color = color.new(color.gray, 50), linestyle = hline.style_solid)
hline(53, "Overbought", color = color.new(color.gray, 60), linestyle = hline.style_dotted)
hline(-53, "Oversold", color = color.new(color.gray, 60), linestyle = hline.style_dotted)

plot(showWaves ? wt1 : na, "Wave 1", color = colWt1, style = plot.style_area, display = display.pane)
plot(showWaves ? wt2 : na, "Wave 2", color = colWt2, style = plot.style_area, display = display.pane)

plot(buyShown ? -100 : na, "Buy dot", color = colBuy, style = plot.style_circles, linewidth = 6, display = display.pane)
plot(addShown and showAdds ? -100 : na, "Extra buy dot", color = colBuy, style = plot.style_circles, linewidth = 6, display = display.pane)
plot(pbShown or (pbAdd and showAdds) ? -85 : na, "Pullback buy dot", color = colPb, style = plot.style_circles, linewidth = 4, display = display.pane)
plot(tpShown ? 100 : na, "Take-profit dot", color = colTp, style = plot.style_circles, linewidth = 6, display = display.pane)
plot(cycShown ? 100 : na, "Cycle exit dot", color = colCyc, style = plot.style_circles, linewidth = 6, display = display.pane)
plotshape(failShown ? -100 : na, "Failed reversal", shape.xcross, location.absolute, colFail, size = size.tiny, display = display.pane)

// ---------------------------------------------------------------------------
// Price chart
// ---------------------------------------------------------------------------
plot(showEmas ? ema20 : na, "EMA 20", color = colE20, linewidth = 1, force_overlay = true, display = display.pane)
plot(showEmas ? ema50 : na, "EMA 50", color = colE50, linewidth = 1, force_overlay = true, display = display.pane)
plot(showEmas ? ema200 : na, "EMA 200", color = colE200, linewidth = 2, force_overlay = true, display = display.pane)

plotshape(buyShown, "Buy arrow", shape.triangleup, location.belowbar, colBuy, size = size.small, force_overlay = true, display = display.pane)
plotshape(addShown and showAdds, "Extra buy arrow", shape.triangleup, location.belowbar, colBuy, size = size.small, force_overlay = true, display = display.pane)
plotshape(pbShown or (pbAdd and showAdds), "Pullback buy arrow", shape.triangleup, location.belowbar, colPb, size = size.tiny, force_overlay = true, display = display.pane)
plotshape(tpShown, "Take-profit arrow", shape.triangledown, location.abovebar, colTp, size = size.small, force_overlay = true, display = display.pane)
plotshape(cycShown, "Cycle exit arrow", shape.triangledown, location.abovebar, colCyc, size = size.small, force_overlay = true, display = display.pane)
plotshape(failShown, "Failed reversal mark", shape.xcross, location.belowbar, colFail, size = size.tiny, force_overlay = true, display = display.pane)

// ---------------------------------------------------------------------------
// Market panel
// ---------------------------------------------------------------------------
f_dir(c, e) =>
    na(c) or na(e) ? "-" : c > e ? "rising" : "falling"

var table panel = table.new(position.top_right, 2, 8, bgcolor = color.new(#131722, 10), border_width = 1, border_color = color.new(color.gray, 70))
f_row(int r, string k, string v, color bg) =>
    table.cell(panel, 0, r, k, text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(panel, 1, r, v, text_color = color.white, bgcolor = bg, text_size = size.small, text_halign = text.align_left)

if showTable and barstate.islast
    table.cell(panel, 0, 0, "RevDots Crypto", text_color = color.white, text_size = size.small, text_halign = text.align_left)
    table.cell(panel, 1, 0, not active ? "Switch to the 1D chart" : isBtc ? "Bitcoin" : "Altcoin", text_color = active ? color.silver : colFail, text_size = size.small, text_halign = text.align_left)
    pnl   = inTrade ? (close / entryPx - 1) * 100 : na
    trade = inTrade ? "LONG since " + str.format_time(entryT, "yyyy-MM-dd", syminfo.timezone) + "  " + (pnl >= 0 ? "+" : "") + str.tostring(pnl, "#.0") + "%" : "FLAT - waiting for a buy"
    f_row(1, "Trade", trade, inTrade ? color.new(colBuy, 60) : color.new(color.gray, 70))
    gTxt = guardOn ? "PAUSED - BTC " + str.tostring(btcDD * 100, "#") + "% from 1y high" : btcDD <= -guardHi / 100 ? "Capitulation zone - buys allowed" : "OK - buys allowed"
    f_row(2, "Cycle guard", useGuard ? gTxt : "off", guardOn ? color.new(colTp, 55) : color.new(colBuy, 75))
    f_row(3, "Bitcoin", "RSI " + str.tostring(bRsi, "#") + " | " + (bClose > bE200 ? "above" : "below") + " 200 EMA" + (bE50 < bE200 ? " | death cross" : ""), na)
    f_row(4, "BTC.D", str.tostring(dClose, "#.0") + "% | " + (dClose < dE20 ? "falling - alts favored" : "rising - BTC favored"), isBtc ? na : dClose < dE20 ? color.new(colBuy, 75) : color.new(colTp, 75))
    f_row(5, "TOTAL", str.tostring(tClose / 1e12, "#.00") + "T | " + (tClose > tE200 ? "above" : "below") + " 200 EMA | RSI " + str.tostring(tRsi, "#"), na)
    f_row(6, "USDT.D", str.tostring(uClose, "#.00") + "% | " + (uClose > uE20 ? "rising - risk-off" : "falling - risk-on") + " | RSI " + str.tostring(uRsi, "#"), uClose > uE20 ? color.new(colTp, 80) : color.new(colBuy, 80))
    watch = not na(lastSetup) and bar_index - lastSetup <= confirmWin ? "Oversold setup - waiting for a bullish close" : inTrade and hiWave >= tpWave and hiRsi >= tpRsi ? "Overbought - take-profit on a close below EMA " + str.tostring(tpEma) : "-"
    f_row(7, "Watch", watch, na)

// ---------------------------------------------------------------------------
// Alerts (use "Once per bar close")
// ---------------------------------------------------------------------------
alertcondition(buyShown or addShown, "Reversal buy", "{{ticker}} 1D: REVERSAL BUY - crypto oversold reversal confirmed")
alertcondition(pbShown or pbAdd, "Pullback buy", "{{ticker}} 1D: PULLBACK BUY - dip inside an uptrend confirmed")
alertcondition(tpShown, "Take-profit trigger", "{{ticker}} 1D: TAKE-PROFIT - overbought, closed below the 20 EMA")
alertcondition(cycShown, "Cycle exit", "{{ticker}} 1D: CYCLE EXIT - Bitcoin 50/200 EMA death cross")
alertcondition(failShown, "Failed reversal", "{{ticker}} 1D: failed reversal - closed below the pre-buy low")
alertcondition(rawBuy and active and guardOn, "Buy skipped by cycle guard", "{{ticker}} 1D: reversal trigger skipped - Bitcoin is in the cycle-guard zone")
