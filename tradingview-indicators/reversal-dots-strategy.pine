//@version=6
// This source code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// Reversal Dots Strategy
//
// Backtest of the Reversal Dots Oscillator playbook (long only):
//   Entry : big buy (green dot from oversold), optionally only strong buys,
//           optionally only when the higher timeframe is in its buy zone.
//   Exit  : Stoch RSI reaches the dotted exit line OR a big sell prints
//           (default), or the posts' rule: dotted line OR any red dot.
//
// Uses the same formulas and defaults as reversal-dots-oscillator.pine.
// Orders fill on the next bar's open. The higher timeframe always uses
// closed bars here, so the backtest does not look ahead.
// Not financial advice. Past results do not predict future results.

strategy("Reversal Dots Strategy", shorttitle = "RevDots Strat", overlay = true, initial_capital = 10000, default_qty_type = strategy.percent_of_equity, default_qty_value = 100, commission_type = strategy.commission.percent, commission_value = 0.1, slippage = 1, pyramiding = 0)

// ---------------------------------------------------------------------------
// Inputs
// ---------------------------------------------------------------------------
grpRules = "Rules"
entryMode = input.string("Big buy", "Entry", options = ["Any green dot", "Early warning", "Big buy", "Strong buy only"], group = grpRules, display = display.none,
     tooltip = "Any green dot: every up-cross. Early warning: fast wave turns up in oversold (before the cross). Big buy: green dot below the oversold level. Strong buy: big buy + bullish divergence.")
useHtf    = input.bool(true, "Only buy when the higher timeframe is in its buy zone", group = grpRules, display = display.none)
exitMode  = input.string("Stoch line or big sell", "Exit", options = ["Stoch line or big sell", "Stoch line or any red dot", "Any red dot", "Stoch line only"], group = grpRules, display = display.none,
     tooltip = "Stoch line or big sell held winners longer and won more often in tests than exiting on any red dot.")
stopPct   = input.float(0.0, "Stop loss % (0 = off)", minval = 0, step = 0.5, group = grpRules, display = display.none)
startDate = input.time(timestamp("2018-01-01T00:00:00"), "Start date", group = grpRules, display = display.none)

grpWT = "WaveTrend"
wtSrc     = input.source(hlc3, "Source", group = grpWT, display = display.none)
wtChLen   = input.int(9, "Channel length", minval = 1, group = grpWT, display = display.none)
wtAvgLen  = input.int(12, "Average length", minval = 1, group = grpWT, display = display.none)
wtMaLen   = input.int(3, "Signal length", minval = 1, group = grpWT, display = display.none)
obLevel   = input.float(53.0, "Big sell: red dot must print above", group = grpWT, display = display.none)
osLevel   = input.float(-53.0, "Big buy: green dot must print below", group = grpWT, display = display.none)

grpSR = "Stochastic RSI"
srSrc     = input.source(close, "Source", group = grpSR, display = display.none)
srUseLog  = input.bool(true, "Use log of source", group = grpSR, display = display.none)
rsiLen    = input.int(14, "RSI length", minval = 1, group = grpSR, display = display.none)
stochLen  = input.int(14, "Stochastic length", minval = 1, group = grpSR, display = display.none)
kSmooth   = input.int(3, "%K smoothing", minval = 1, group = grpSR, display = display.none)
exitLevel = input.float(99.0, "Exit when %K reaches", minval = 0, maxval = 100, group = grpSR, display = display.none)

grpDiv = "Divergences (strong buy)"
divBotLimit = input.float(-40.0, "Bullish: wave bottom must be below", group = grpDiv, display = display.none)
divLookback = input.int(60, "Max bars between pivots", minval = 5, group = grpDiv, display = display.none)
strongBars  = input.int(6, "Divergence within (bars) of the big buy", minval = 0, group = grpDiv, display = display.none)

grpHtf = "Higher timeframe"
htfInput  = input.timeframe("", "Higher timeframe (empty = auto)", group = grpHtf, display = display.none,
     tooltip = "Auto: up to 15m -> 1H, up to 1H -> 4H, up to 4H -> D, D -> W, W -> M.")
htfBuyMax = input.float(0.0, "HTF buy zone: slow wave below", group = grpHtf, display = display.none)
htfNeedUp = input.bool(false, "Also require HTF fast wave rising (stricter, far fewer trades)", group = grpHtf, display = display.none)

// ---------------------------------------------------------------------------
// Functions
// ---------------------------------------------------------------------------
f_waves(src, chLen, avgLen, maLen) =>
    esa = ta.ema(src, chLen)
    de  = ta.ema(math.abs(src - esa), chLen)
    ci  = de == 0 ? 0.0 : (src - esa) / (0.015 * de)
    w1  = ta.ema(ci, avgLen)
    w2  = ta.sma(w1, maLen)
    [w1, w2]

f_stochK(src, useLog, rLen, sLen, kLen) =>
    r = ta.rsi(useLog ? math.log(src) : src, rLen)
    ta.sma(ta.stoch(r, r, r, sLen), kLen)

// Last closed higher-timeframe bar: slow wave, fast wave and previous fast wave
f_htfState() =>
    [w1, w2] = f_waves(wtSrc, wtChLen, wtAvgLen, wtMaLen)
    [w1[1], w2[1], w1[2]]

f_autoTf() =>
    s = timeframe.in_seconds()
    s <= 900 ? "60" : s <= 3600 ? "240" : s <= 14400 ? "D" : s <= 86400 ? "W" : s <= 604800 ? "M" : "3M"

// ---------------------------------------------------------------------------
// Signals
// ---------------------------------------------------------------------------
[wt1, wt2] = f_waves(wtSrc, wtChLen, wtAvgLen, wtMaLen)
crossUp = ta.crossover(wt1, wt2)
crossDn = ta.crossunder(wt1, wt2)
bigBuy  = crossUp and wt2 <= osLevel
bigSell = crossDn and wt2 >= obLevel

var bool earlyBuyDone = false
if crossUp or crossDn
    earlyBuyDone := false
earlyBuy = not earlyBuyDone and wt1 > wt1[1] and wt1[1] <= wt1[2] and wt1 < wt2 and wt2 <= osLevel
if earlyBuy
    earlyBuyDone := true

k     = f_stochK(srSrc, srUseLog, rsiLen, stochLen, kSmooth)
kExit = k >= exitLevel and k[1] < exitLevel

// Bullish divergence (wave trough higher, price low lower), confirmed 2 bars later
isBot = wt2[4] > wt2[2] and wt2[3] > wt2[2] and wt2[2] < wt2[1] and wt2[2] < wt2
var float prevBotWt  = na
var float prevBotPx  = na
var int   prevBotBar = na
bullDiv = false
pivBar  = bar_index - 2
if isBot and wt2[2] <= divBotLimit
    if not na(prevBotWt) and pivBar - prevBotBar <= divLookback and wt2[2] > prevBotWt and low[2] < prevBotPx
        bullDiv := true
    prevBotWt  := wt2[2]
    prevBotPx  := low[2]
    prevBotBar := pivBar

// Strong buy: big buy with a bullish divergence within strongBars (before or after)
var int lastBigBuyBar    = na
var int lastBullDivBar   = na
var int lastStrongBuyBar = na
if bigBuy
    lastBigBuyBar := bar_index
if bullDiv
    lastBullDivBar := bar_index
strongBuy = false
if (bigBuy or bullDiv) and not na(lastBigBuyBar) and not na(lastBullDivBar) and math.abs(lastBigBuyBar - lastBullDivBar) <= strongBars and lastBigBuyBar != nz(lastStrongBuyBar, -1)
    strongBuy        := true
    lastStrongBuyBar := lastBigBuyBar

// Higher timeframe buy zone (closed bars only)
htfTf = htfInput == "" ? f_autoTf() : htfInput
[hW1, hW2, hW1Prev] = request.security(syminfo.tickerid, htfTf, f_htfState(), lookahead = barmerge.lookahead_on)
htfReady = not na(hW2) and not na(hW1) and not na(hW1Prev)
htfBull  = htfReady and hW2 <= htfBuyMax and (not htfNeedUp or hW1 > hW1Prev)
// Young tickers (e.g. a coin listed last year on a weekly chart -> monthly HTF)
// don't have enough higher-timeframe bars. Skip the filter instead of blocking every trade.
htfOk    = not useHtf or not htfReady or htfBull

// ---------------------------------------------------------------------------
// Orders
// ---------------------------------------------------------------------------
entrySignal = switch entryMode
    "Any green dot"   => crossUp
    "Early warning"   => earlyBuy
    "Strong buy only" => strongBuy
    => bigBuy

exitSignal = switch exitMode
    "Stoch line or big sell" => kExit or bigSell
    "Any red dot"            => crossDn
    "Stoch line only"        => kExit
    => kExit or crossDn

inRange = time >= startDate
longOk  = entrySignal and inRange and htfOk

if longOk and strategy.position_size == 0
    strategy.entry("Long", strategy.long, comment = " ")

if strategy.position_size > 0
    if exitSignal
        strategy.close("Long", comment = " ")
    else if stopPct > 0
        strategy.exit("Stop", "Long", stop = strategy.position_avg_price * (1 - stopPct / 100), comment = " ")

var table info = table.new(position.top_right, 1, 2, bgcolor = color.new(#131722, 10), border_width = 1, border_color = color.new(color.gray, 70))
if barstate.islast
    htfMsg = not useHtf ? "HTF filter: off" : htfReady ? "HTF filter: " + htfTf + (htfBull ? " BUY ZONE" : " WAIT") : "HTF " + htfTf + ": not enough history, filter skipped"
    table.cell(info, 0, 0, "RevDots Strat | Entry: " + entryMode + " | Trades: " + str.tostring(strategy.closedtrades + strategy.opentrades), text_color = color.white, text_size = size.small, text_halign = text.align_left)
    table.cell(info, 0, 1, htfMsg, text_color = useHtf and not htfReady ? #FFD600 : color.silver, text_size = size.small, text_halign = text.align_left)

plotshape(longOk and strategy.position_size == 0, "Entry arrow", shape.triangleup, location.belowbar, color.new(#00E676, 0), size = size.small, display = display.pane)
plotshape(exitSignal and strategy.position_size > 0, "Exit arrow", shape.triangledown, location.abovebar, color.new(#FF5252, 0), size = size.small, display = display.pane)
