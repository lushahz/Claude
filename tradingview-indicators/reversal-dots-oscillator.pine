//@version=6
// This source code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// Reversal Dots Oscillator
//
// Rebuild of the "green dot / red dot" reversal oscillator style seen in the
// overkilltrading TradingView ideas. Written from public formulas:
//   - WaveTrend oscillator (LazyBear)        -> blue / navy waves + green/red dots
//   - Stochastic RSI %K                       -> light blue line, exit at dotted 100 line
//   - RSI                                     -> magenta line
//   - WaveTrend fractal divergences           -> red / green divergence lines
//   - Big / strong signal dots at the pane top and bottom
//   - Early-warning dots (fast wave turns before the cross)
//   - Higher-timeframe panel + "setup" signals (chart buy while HTF is in a buy zone)
//   - Candle-body money flow (optional)       -> white area around zero
//   - 20 / 50 / 200 EMAs on the price chart   (force_overlay)
//
// Not financial advice. Signals on the live bar can change until the bar closes.

indicator("Reversal Dots Oscillator", shorttitle = "RevDots", overlay = false, precision = 2, max_lines_count = 300, max_labels_count = 300)

// ---------------------------------------------------------------------------
// Inputs
// ---------------------------------------------------------------------------
grpWT = "WaveTrend (waves + dots)"
showWaves = input.bool(true, "Show waves", group = grpWT)
showDots  = input.bool(true, "Show green / red cross dots", group = grpWT)
wtSrc     = input.source(hlc3, "Source", group = grpWT)
wtChLen   = input.int(9, "Channel length", minval = 1, group = grpWT)
wtAvgLen  = input.int(12, "Average length", minval = 1, group = grpWT)
wtMaLen   = input.int(3, "Signal length", minval = 1, group = grpWT)
obLevel   = input.float(53.0, "Big sell: red dot must print above", group = grpWT)
osLevel   = input.float(-53.0, "Big buy: green dot must print below", group = grpWT)

grpEarly = "Early warning (yellow dots)"
showEarly = input.bool(true, "Show early-warning dots", group = grpEarly,
     tooltip = "Fast wave turns up while still below the slow wave in oversold (or turns down in overbought). Usually 1-2 bars before the green / red dot. Earlier, but fails more often.")

grpHtf = "Higher timeframe"
showHtf    = input.bool(true, "Show higher-timeframe panel", group = grpHtf)
htfInput   = input.timeframe("", "Higher timeframe (empty = auto)", group = grpHtf,
     tooltip = "Auto: up to 15m -> 1H, up to 1H -> 4H, up to 4H -> D, D -> W, W -> M.")
htfLive    = input.bool(false, "Use the still-forming HTF bar (earlier, can repaint)", group = grpHtf)
htfBuyMax  = input.float(0.0, "HTF buy zone: slow wave below", group = grpHtf)
htfPos     = input.string("Top right", "Panel position", options = ["Top right", "Top left", "Bottom right", "Bottom left"], group = grpHtf)
showSetup  = input.bool(true, "Mark setup buys on price chart", group = grpHtf,
     tooltip = "Setup buy = big buy on this chart while the higher timeframe is in its buy zone (slow wave below the level above and fast wave rising).")

grpMF = "Money flow (white area)"
showMF = input.bool(false, "Show money flow", group = grpMF)
mfLen  = input.int(60, "Period", minval = 1, group = grpMF)
mfMult = input.float(150.0, "Multiplier", group = grpMF)
mfPosY = input.float(2.5, "Vertical shift", group = grpMF)

grpSR = "Stochastic RSI (light blue line)"
showK     = input.bool(true, "Show %K", group = grpSR)
showD     = input.bool(false, "Show %D", group = grpSR)
srSrc     = input.source(close, "Source", group = grpSR)
srUseLog  = input.bool(true, "Use log of source (better for crypto)", group = grpSR)
rsiLen    = input.int(14, "RSI length", minval = 1, group = grpSR)
stochLen  = input.int(14, "Stochastic length", minval = 1, group = grpSR)
kSmooth   = input.int(3, "%K smoothing", minval = 1, group = grpSR)
dSmooth   = input.int(3, "%D smoothing", minval = 1, group = grpSR)
exitLevel = input.float(99.0, "Exit alert when %K reaches", minval = 0, maxval = 100, group = grpSR,
     tooltip = "Take-profit rule from the ideas: sell when the light blue line hits the white dotted line or a red dot prints, whichever comes first.")

grpRSI = "RSI (magenta line)"
showRsi   = input.bool(true, "Show RSI", group = grpRSI)
rsiSrc    = input.source(close, "Source", group = grpRSI)
rsiLen2   = input.int(14, "Length", minval = 1, group = grpRSI)
rsiOb     = input.float(70.0, "Overbought (turns red)", group = grpRSI)
rsiOs     = input.float(30.0, "Oversold (turns green)", group = grpRSI)

grpDiv = "Divergences"
showDiv     = input.bool(true, "Draw divergence lines", group = grpDiv)
divTopLimit = input.float(45.0, "Bearish: wave top must be above", group = grpDiv)
divBotLimit = input.float(-40.0, "Bullish: wave bottom must be below", group = grpDiv)
divLookback = input.int(60, "Max bars between pivots", minval = 5, group = grpDiv)

grpSig = "Signal dots (pane top / bottom)"
showSig    = input.bool(true, "Show big / strong signal dots", group = grpSig)
sigTop     = input.float(107.0, "Sell dots at", group = grpSig)
sigBot     = input.float(-107.0, "Buy dots at", group = grpSig)
strongBars = input.int(6, "Strong = big signal + divergence within (bars)", minval = 0, group = grpSig,
     tooltip = "A big buy/sell that comes with a divergence prints a larger, brighter dot.")

grpLv = "Levels"
lvTop    = input.float(100.0, "Dotted exit line", group = grpLv)
lvUpper  = input.float(60.0, "Upper band", group = grpLv)
lvLower  = input.float(-40.0, "Lower band", group = grpLv)
lvColor  = input.color(color.white, "Level color", group = grpLv)

grpPx = "Price chart"
showEmas     = input.bool(true, "Show EMAs on price chart", group = grpPx)
ema1Len      = input.int(20, "EMA 1", minval = 1, inline = "e1", group = grpPx)
ema1Col      = input.color(#FF9800, "", inline = "e1", group = grpPx)
ema2Len      = input.int(50, "EMA 2", minval = 1, inline = "e2", group = grpPx)
ema2Col      = input.color(#D1D4DC, "", inline = "e2", group = grpPx)
ema3Len      = input.int(200, "EMA 3", minval = 1, inline = "e3", group = grpPx)
ema3Col      = input.color(#3949AB, "", inline = "e3", group = grpPx)
showPxSignal = input.bool(false, "Show big buy / sell arrows on price chart", group = grpPx)

grpCol = "Colors"
colWt1   = input.color(#4A7FC1, "Wave 1 (fast)", group = grpCol)
colWt2   = input.color(#262668, "Wave 2 (slow)", group = grpCol)
colMfUp  = input.color(color.new(color.white, 0), "Money flow +", group = grpCol)
colMfDn  = input.color(color.new(color.white, 0), "Money flow -", group = grpCol)
colK     = input.color(#21BAF3, "Stoch RSI %K", group = grpCol)
colD     = input.color(color.new(#673AB7, 30), "Stoch RSI %D", group = grpCol)
colRsi   = input.color(#C33EE1, "RSI", group = grpCol)
colBull  = input.color(#00E676, "Bull (green dot)", group = grpCol)
colBear  = input.color(#FF5252, "Bear (red dot)", group = grpCol)
colBigB  = input.color(#1B7A3A, "Big buy dot", group = grpCol)
colBigS  = input.color(#9E1F1F, "Big sell dot", group = grpCol)
colEarly = input.color(#FFD600, "Early warning dot", group = grpCol)

// ---------------------------------------------------------------------------
// Functions
// ---------------------------------------------------------------------------
f_waves(src, chLen, avgLen, maLen) =>
    esa = ta.ema(src, chLen)
    de  = ta.ema(math.abs(src - esa), chLen)
    ci  = de == 0 ? 0.0 : (src - esa) / (0.015 * de)
    w1  = ta.ema(ci, avgLen)
    w2  = ta.sma(w1, maLen)
    [w1, w2]

f_stochK(src, useLog, rLen, sLen, kLen) =>
    r = ta.rsi(useLog ? math.log(src) : src, rLen)
    ta.sma(ta.stoch(r, r, r, sLen), kLen)

// Higher-timeframe state, shifted by `off` bars (1 = last closed HTF bar)
f_htfState(off) =>
    [w1, w2] = f_waves(wtSrc, wtChLen, wtAvgLen, wtMaLen)
    kk      = f_stochK(srSrc, srUseLog, rsiLen, stochLen, kSmooth)
    up      = ta.crossover(w1, w2)
    dn      = ta.crossunder(w1, w2)
    barsUp  = ta.barssince(up)
    barsDn  = ta.barssince(dn)
    [w1[off], w2[off], w1[off + 1], kk[off], barsUp[off], barsDn[off]]

f_autoTf() =>
    s = timeframe.in_seconds()
    s <= 900 ? "60" : s <= 3600 ? "240" : s <= 14400 ? "D" : s <= 86400 ? "W" : s <= 604800 ? "M" : "3M"

// ---------------------------------------------------------------------------
// Calculations
// ---------------------------------------------------------------------------
[wt1, wt2] = f_waves(wtSrc, wtChLen, wtAvgLen, wtMaLen)

crossUp = ta.crossover(wt1, wt2)
crossDn = ta.crossunder(wt1, wt2)
bigBuy  = crossUp and wt2 <= osLevel
bigSell = crossDn and wt2 >= obLevel

// Early warning: first turn of the fast wave before the cross, once per swing
var bool earlyBuyDone  = false
var bool earlySellDone = false
if crossUp or crossDn
    earlyBuyDone  := false
    earlySellDone := false
turnUp    = wt1 > wt1[1] and wt1[1] <= wt1[2]
turnDn    = wt1 < wt1[1] and wt1[1] >= wt1[2]
earlyBuy  = not earlyBuyDone and turnUp and wt1 < wt2 and wt2 <= osLevel
earlySell = not earlySellDone and turnDn and wt1 > wt2 and wt2 >= obLevel
if earlyBuy
    earlyBuyDone := true
if earlySell
    earlySellDone := true

// Money flow: average candle-body strength
barRange = high - low
mf = ta.sma(barRange == 0 ? 0.0 : (close - open) / barRange * mfMult, mfLen) - mfPosY

// Stochastic RSI
k     = f_stochK(srSrc, srUseLog, rsiLen, stochLen, kSmooth)
d     = ta.sma(k, dSmooth)
kExit = k >= exitLevel and k[1] < exitLevel

// RSI
rsiLine  = ta.rsi(rsiSrc, rsiLen2)
rsiColor = rsiLine >= rsiOb ? colBear : rsiLine <= rsiOs ? colBull : colRsi

// Divergences on WaveTrend fractals (pivot confirmed 2 bars later).
// Only pivots beyond the limits are remembered, so small bumps in between
// don't break the comparison between two major peaks / troughs.
isTop = wt2[4] < wt2[2] and wt2[3] < wt2[2] and wt2[2] > wt2[1] and wt2[2] > wt2
isBot = wt2[4] > wt2[2] and wt2[3] > wt2[2] and wt2[2] < wt2[1] and wt2[2] < wt2

var float prevTopWt  = na
var float prevTopPx  = na
var int   prevTopBar = na
var float prevBotWt  = na
var float prevBotPx  = na
var int   prevBotBar = na

bearDiv = false
bullDiv = false
pivBar  = bar_index - 2

if isTop and wt2[2] >= divTopLimit
    curWt = wt2[2]
    curPx = high[2]
    if not na(prevTopWt) and pivBar - prevTopBar <= divLookback and curWt < prevTopWt and curPx > prevTopPx
        bearDiv := true
        if showDiv
            line.new(prevTopBar, prevTopWt, pivBar, curWt, color = colBear, width = 2)
    prevTopWt  := curWt
    prevTopPx  := curPx
    prevTopBar := pivBar

if isBot and wt2[2] <= divBotLimit
    curWt = wt2[2]
    curPx = low[2]
    if not na(prevBotWt) and pivBar - prevBotBar <= divLookback and curWt > prevBotWt and curPx < prevBotPx
        bullDiv := true
        if showDiv
            line.new(prevBotBar, prevBotWt, pivBar, curWt, color = colBull, width = 2)
    prevBotWt  := curWt
    prevBotPx  := curPx
    prevBotBar := pivBar

// Strong signals: a big buy/sell paired with a divergence within strongBars.
// The divergence can confirm a little before or after the dot, so the strong
// dot is drawn on the bar of the big signal itself.
var int lastBigBuyBar     = na
var int lastBigSellBar    = na
var int lastBullDivBar    = na
var int lastBearDivBar    = na
var int lastStrongBuyBar  = na
var int lastStrongSellBar = na
if bigBuy
    lastBigBuyBar := bar_index
if bigSell
    lastBigSellBar := bar_index
if bullDiv
    lastBullDivBar := bar_index
if bearDiv
    lastBearDivBar := bar_index

strongBuy  = false
strongSell = false
if (bigBuy or bullDiv) and not na(lastBigBuyBar) and not na(lastBullDivBar) and math.abs(lastBigBuyBar - lastBullDivBar) <= strongBars and lastBigBuyBar != nz(lastStrongBuyBar, -1)
    strongBuy        := true
    lastStrongBuyBar := lastBigBuyBar
    if showSig
        label.new(lastBigBuyBar, sigBot, "", style = label.style_circle, color = colBull, size = size.tiny, tooltip = "Strong buy: big buy + bullish divergence")
if (bigSell or bearDiv) and not na(lastBigSellBar) and not na(lastBearDivBar) and math.abs(lastBigSellBar - lastBearDivBar) <= strongBars and lastBigSellBar != nz(lastStrongSellBar, -1)
    strongSell        := true
    lastStrongSellBar := lastBigSellBar
    if showSig
        label.new(lastBigSellBar, sigTop, "", style = label.style_circle, color = colBear, size = size.tiny, tooltip = "Strong sell: big sell + bearish divergence")

// ---------------------------------------------------------------------------
// Higher timeframe
// ---------------------------------------------------------------------------
htfTf  = htfInput == "" ? f_autoTf() : htfInput
htfOff = htfLive ? 0 : 1
[hW1, hW2, hW1Prev, hK, hBarsUp, hBarsDn] = request.security(syminfo.tickerid, htfTf, f_htfState(htfOff), lookahead = htfLive ? barmerge.lookahead_off : barmerge.lookahead_on)

htfReady  = not na(hW2) and not na(hW1) and not na(hW1Prev)
htfRising = hW1 > hW1Prev
htfBull   = htfReady and htfRising and hW2 <= htfBuyMax
htfAvoid  = htfReady and (not htfRising or hW2 >= lvUpper)
setupBuy  = bigBuy and htfBull

var table htfTable = table.new(htfPos == "Top left" ? position.top_left : htfPos == "Bottom right" ? position.bottom_right : htfPos == "Bottom left" ? position.bottom_left : position.top_right, 2, 6, bgcolor = color.new(#131722, 10), border_width = 1, border_color = color.new(color.gray, 70))

f_cell(r, txt, val, bg) =>
    table.cell(htfTable, 0, r, txt, text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(htfTable, 1, r, val, text_color = color.white, bgcolor = bg, text_size = size.small, text_halign = text.align_left)

if showHtf and barstate.islast and not htfReady
    table.cell(htfTable, 0, 0, "HTF " + htfTf, text_color = color.white, text_size = size.small, text_halign = text.align_left)
    table.cell(htfTable, 1, 0, "Not enough history on this timeframe. Pick a lower HTF in settings.", text_color = #FFD600, text_size = size.small, text_halign = text.align_left)
else if showHtf and barstate.islast
    zone    = hW2 <= lvLower ? "Oversold" : hW2 >= lvUpper ? "Overbought" : "Neutral"
    zoneBg  = hW2 <= lvLower ? color.new(colBull, 70) : hW2 >= lvUpper ? color.new(colBear, 70) : na
    upFirst = nz(hBarsUp, 100000) < nz(hBarsDn, 100000)
    lastDot = na(hBarsUp) and na(hBarsDn) ? "-" : upFirst ? "Green, " + str.tostring(hBarsUp) + " bars ago" : "Red, " + str.tostring(hBarsDn) + " bars ago"
    dotBg   = upFirst ? color.new(colBull, 70) : color.new(colBear, 70)
    bias    = htfBull ? "BUY ZONE - take chart buys" : htfAvoid ? "WAIT - avoid buys" : "Neutral"
    biasBg  = htfBull ? color.new(colBull, 40) : htfAvoid ? color.new(colBear, 50) : color.new(color.gray, 60)
    table.cell(htfTable, 0, 0, "HTF " + htfTf + (htfLive ? " (live)" : ""), text_color = color.white, text_size = size.small, text_halign = text.align_left)
    table.cell(htfTable, 1, 0, "", text_size = size.small)
    f_cell(1, "Waves", str.tostring(hW2, "#.0") + "  " + zone, zoneBg)
    f_cell(2, "Direction", htfRising ? "Rising" : "Falling", htfRising ? color.new(colBull, 70) : color.new(colBear, 70))
    f_cell(3, "Last dot", lastDot, dotBg)
    f_cell(4, "Stoch RSI", str.tostring(hK, "#"), hK >= exitLevel ? color.new(colBear, 70) : na)
    f_cell(5, "Bias", bias, biasBg)

// ---------------------------------------------------------------------------
// Oscillator pane
// ---------------------------------------------------------------------------
hline(0, "Zero", color = color.new(lvColor, 40), linestyle = hline.style_solid)
hline(lvTop, "Exit line", color = lvColor, linestyle = hline.style_dotted, linewidth = 2)
hline(lvUpper, "Upper band", color = lvColor, linestyle = hline.style_solid)
hline(lvLower, "Lower band", color = lvColor, linestyle = hline.style_solid)

plot(showWaves ? wt1 : na, "Wave 1", color = colWt1, style = plot.style_area)
plot(showWaves ? wt2 : na, "Wave 2", color = colWt2, style = plot.style_area)
plot(showMF ? mf : na, "Money flow", color = mf >= 0 ? colMfUp : colMfDn, style = plot.style_area)

plot(showD ? d : na, "Stoch RSI %D", color = colD, linewidth = 1)
plot(showK ? k : na, "Stoch RSI %K", color = colK, linewidth = 2)
plot(showRsi ? rsiLine : na, "RSI", color = rsiColor, linewidth = 2)

// Every wave cross: green dot = turning up, red dot = turning down
plot(showDots and crossUp ? wt2 : na, "Green dot", color = colBull, style = plot.style_circles, linewidth = 4)
plot(showDots and crossDn ? wt2 : na, "Red dot", color = colBear, style = plot.style_circles, linewidth = 4)

// Early warning: fast wave turned before the cross
plot(showEarly and earlyBuy ? wt1 : na, "Early buy warning", color = colEarly, style = plot.style_circles, linewidth = 3)
plot(showEarly and earlySell ? wt1 : na, "Early sell warning", color = colEarly, style = plot.style_circles, linewidth = 3)

// Big signals (cross from oversold / overbought) as small dark dots at the pane edges.
// Strong signals (with divergence) are drawn above as bigger bright dots (labels).
plot(showSig and bigBuy ? sigBot : na, "Big buy", color = colBigB, style = plot.style_circles, linewidth = 3)
plot(showSig and bigSell ? sigTop : na, "Big sell", color = colBigS, style = plot.style_circles, linewidth = 3)

// Divergence pivots (drawn 2 bars back where the pivot actually is)
plot(bearDiv ? wt2[2] : na, "Bearish divergence", color = colBear, style = plot.style_circles, linewidth = 6, offset = -2)
plot(bullDiv ? wt2[2] : na, "Bullish divergence", color = colBull, style = plot.style_circles, linewidth = 6, offset = -2)

// ---------------------------------------------------------------------------
// Price chart overlay
// ---------------------------------------------------------------------------
ema1 = ta.ema(close, ema1Len)
ema2 = ta.ema(close, ema2Len)
ema3 = ta.ema(close, ema3Len)
plot(showEmas ? ema1 : na, "EMA 1", color = ema1Col, linewidth = 1, force_overlay = true)
plot(showEmas ? ema2 : na, "EMA 2", color = ema2Col, linewidth = 1, force_overlay = true)
plot(showEmas ? ema3 : na, "EMA 3", color = ema3Col, linewidth = 2, force_overlay = true)

plotshape(showPxSignal and bigBuy and not (showSetup and setupBuy), "Buy arrow", shape.triangleup, location.belowbar, colBull, size = size.small, force_overlay = true)
plotshape(showPxSignal and bigSell, "Sell arrow", shape.triangledown, location.abovebar, colBear, size = size.small, force_overlay = true)
plotshape(showSetup and setupBuy, "Setup buy", shape.labelup, location.belowbar, colBull, text = "BUY", textcolor = color.black, size = size.small, force_overlay = true)

// ---------------------------------------------------------------------------
// Alerts (use "Once per bar close" to avoid signals that disappear intrabar)
// ---------------------------------------------------------------------------
alertcondition(crossUp, "Green dot", "{{ticker}} {{interval}}: green dot (WaveTrend crossed up)")
alertcondition(crossDn, "Red dot", "{{ticker}} {{interval}}: red dot (WaveTrend crossed down)")
alertcondition(earlyBuy, "Early buy warning", "{{ticker}} {{interval}}: early buy warning - fast wave turned up in oversold")
alertcondition(earlySell, "Early sell warning", "{{ticker}} {{interval}}: early sell warning - fast wave turned down in overbought")
alertcondition(bigBuy, "Big buy", "{{ticker}} {{interval}}: BIG BUY - green dot from oversold")
alertcondition(bigSell, "Big sell", "{{ticker}} {{interval}}: BIG SELL - red dot from overbought")
alertcondition(strongBuy, "Strong buy", "{{ticker}} {{interval}}: STRONG BUY - big buy + bullish divergence")
alertcondition(strongSell, "Strong sell", "{{ticker}} {{interval}}: STRONG SELL - big sell + bearish divergence")
alertcondition(setupBuy, "Setup buy (HTF in buy zone)", "{{ticker}} {{interval}}: SETUP BUY - big buy while the higher timeframe is in its buy zone")
alertcondition(bullDiv, "Bullish divergence", "{{ticker}} {{interval}}: bullish WaveTrend divergence")
alertcondition(bearDiv, "Bearish divergence", "{{ticker}} {{interval}}: bearish WaveTrend divergence")
alertcondition(kExit, "Stoch RSI at exit line", "{{ticker}} {{interval}}: Stoch RSI reached the dotted exit line")
alertcondition(kExit or crossDn, "Exit (dotted line or red dot)", "{{ticker}} {{interval}}: exit signal - Stoch RSI at exit line or red dot")
